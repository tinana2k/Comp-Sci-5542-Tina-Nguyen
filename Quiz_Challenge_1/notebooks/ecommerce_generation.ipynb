   "source": [
    "import os\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from PIL import Image\n",
    "import sys\n",
    "sys.path.append('..') # Add src to path\n",
    "\n",
    "from src.generator import PromptEngine\n",
    "\n",
    "# Constants\n",
    "DATA_PATH = \"../data/products.csv\"\n",
    "OUTPUT_BASE = \"../outputs/baseline\"\n",
    "OUTPUT_IMPROVED = \"../outputs/improved\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Load Product Metadata"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pd.read_csv(DATA_PATH).dropna(how='all')\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Prompt Engineering Comparison\n",
    "\n",
    "We compare the **Naive Strategy** (Baseline) vs the **Structured Strategy** (Improved) which incorporates:\n",
    "- Professional Lighting\n",
    "- Compositional Rules\n",
    "- Material Fidelity Tags\n",
    "- Negative Prompts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "engine = PromptEngine()\n",
    "\n",
    "for index, row in df.head(3).iterrows():\n",
    "    print(f\"--- Product {int(row['product_id'])}: {row['title']} ---\")\n",
    "    print(f\"Baseline: {engine.generate_baseline_prompt(row)}\")\n",
    "    print(f\"Improved: {engine.generate_improved_prompt(row)}\\n\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Visual Comparison\n",
    "Let's visualize the results generated by our pipeline."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def show_comparison(p_id, title):\n",
    "    baseline_path = os.path.join(OUTPUT_BASE, f\"prod_{p_id}_baseline.png\")\n",
    "    improved_path = os.path.join(OUTPUT_IMPROVED, f\"prod_{p_id}_improved.png\")\n",
    "    \n",
    "    if not os.path.exists(baseline_path) or not os.path.exists(improved_path):\n",
    "        print(f\"Images for product {p_id} not found. Ensure generator has run.\")\n",
    "        return\n",
    "\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(12, 6))\n",
    "    \n",
    "    axes[0].imshow(Image.open(baseline_path))\n",
    "    axes[0].set_title(f\"Baseline: {title}\")\n",
    "    axes[0].axis('off')\n",
    "    \n",
    "    axes[1].imshow(Image.open(improved_path))\n",
    "    axes[1].set_title(f\"Improved: {title}\")\n",
    "    axes[1].axis('off')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Visualize the first 3 products\n",
    "for _, row in df.head(3).iterrows():\n",
    "    show_comparison(int(row['product_id']), row['title'])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
